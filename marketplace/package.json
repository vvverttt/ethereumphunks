{
  "name": "etherphunks-market",
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node prebuild.js",
    "ng": "ng",
    "start:sepolia": "ng serve --configuration dev-sepolia --host 127.0.0.1 --port 9000",
    "start:mainnet": "ng serve --configuration dev-mainnet --host 127.0.0.1 --port 9000",
    "start:sepolia:9000": "ng serve --configuration dev-sepolia --host 127.0.0.1 --port 9000",
    "start:mainnet:9000": "ng serve --configuration dev-mainnet --host 127.0.0.1 --port 9000",
    "build": "yarn build:sepolia && yarn build:mainnet",
    "build:sepolia": "yarn prebuild && ng build --configuration sepolia && node copy-to-fixed.js sepolia",
    "build:mainnet": "yarn prebuild && ng build --configuration mainnet && node bundle-static-assets.mjs --config mainnet && node build-sprite.mjs --config mainnet --prune && node copy-to-fixed.js mainnet",
    "build:production": "ng build --configuration production",
    "build:ipfs": "yarn prebuild && ng build --configuration mainnet-ipfs && node bundle-static-assets.mjs --config mainnet-ipfs && node build-sprite.mjs --config mainnet-ipfs --prune && node disable-sw.mjs --config mainnet-ipfs",
    "test": "ng test",
    "run-built": "http-server dist/etherphunks-market -p 8000",
    "translate": "ng extract-i18n --output-path src/locale",
    "translate:json": "ng extract-i18n --output-path src/locale --format=json",
    "pin:ipfs": "node pin-ipfs.mjs --config mainnet-ipfs --car dist/site.car",
    "deploy:ipfs:sepolia": "node deploy-ipfs.js --configuration=sepolia",
    "deploy:ipfs:mainnet": "node deploy-ipfs.js --configuration=mainnet-ipfs",
    "deploy:ipfs": "yarn deploy:ipfs:mainnet && yarn deploy:ipfs:sepolia"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.3.0",
    "@angular/cdk": "^22",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/service-worker": "22.3.0",
    "@ng-select/ng-select": "^24.2.1",
    "@ng-web-apis/common": "^5.4.1",
    "@ng-web-apis/intersection-observer": "^5.4.1",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "@supabase/supabase-js": "^2.47.16",
    "@wagmi/connectors": "^5.8.1",
    "@wagmi/core": "^2.17.1",
    "@web3modal/wagmi": "^5.1.11",
    "@xmtp/xmtp-js": "^11.4.1",
    "animejs": "^3.2.1",
    "dotenv": "^16.4.5",
    "fireworks-js": "^2.10.8",
    "gsap": "^3.12.7",
    "localforage": "^1.10.0",
    "moment": "^2.31.0",
    "ng-lazyload-image": "^9.1.3",
    "ngx-pagination": "^6.0.3",
    "ngx-socket-io": "^4.11.1",
    "ngx-timeago": "^4.1.0",
    "pinata": "^2.4.9",
    "react": "^18.3.1",
    "rxjs": "^7.4.0",
    "svgson": "^5.3.1",
    "tinycolor2": "^1.6.0",
    "tippy.js": "^6.3.7",
    "tslib": "^2.1.0",
    "uri-js": "^4.4.1",
    "uuid": "^11.1.1",
    "viem": "^2.29.0",
    "webpack": "^5.47.1",
    "zone.js": "~0.15.0"
  },
  "resolutions": {
    "lit": "^3.1.0",
    "@lit/reactive-element": "^2.0.0",
    "hono": "4.13.16",
    "h3": "1.15.11",
    "defu": "6.1.7",
    "lodash": "4.18.1",
    "qs": "6.17.1",
    "fast-uri": "3.1.9",
    "browserslist": "4.29.5",
    "protobufjs": "7.6.6",
    "engine.io": "6.6.11",
    "socket.io-parser": "4.2.7",
    "baseline-browser-mapping": "2.11.35",
    "moment": "2.31.0",
    "ajv": "8.20.0",
    "ws": "8.22.1",
    "@babel/core": "^7.29.13",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.20",
    "postcss": "^8.5.33",
    "postcss-selector-parser": "^7.2.1",
    "serialize-javascript": "^7.1.4",
    "source-map-js": "^1.2.3"
