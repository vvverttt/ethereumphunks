    "@types/jasmine": "~3.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.3",
    "@types/tinycolor2": "^1.4.3",
    "@types/uuid": "^9.0.8",
    "typescript": "6.0.3"
  }
}
