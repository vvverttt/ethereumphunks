# Bundled collection images are stored by sha with no file extension, the way Supabase
# serves them, so a host has nothing to derive a type from. Both eth.limo and the Pages
# deploy send X-Content-Type-Options: nosniff, which stops the browser from working it
# out itself, so declare it here. Content is addressed by hash and can never change.
/static/images/*
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

/ngsw.json
  Cache-Control: no-cache, no-store, must-revalidate

/ngsw-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/*
  Content-Security-Policy: default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://secure.walletconnect.com https://secure.walletconnect.org https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://kfnprbhoodmgfhqojmqp.supabase.co wss://kfnprbhoodmgfhqojmqp.supabase.co https://*.alchemy.com https://rpc.ankr.com https://rpc.mevblocker.io https://1rpc.io https://eth.llamarpc.com https://api.ethscriptions.com https://ethereumphunks.onrender.com wss://ethereumphunks.onrender.com https://*.walletconnect.com https://*.walletconnect.org wss://*.walletconnect.com wss://*.walletconnect.org https://rpc.walletconnect.com wss://relay.walletconnect.com https://min-api.cryptocompare.com https://api.coinbase.com https://api.coingecko.com https://api.web3modal.com https://api.web3modal.org https://explorer-api.walletconnect.com https://pulse.walletconnect.org https://fonts.googleapis.com https://fonts.gstatic.com https://static.cloudflareinsights.com; frame-src 'self' https://*.walletconnect.com https://*.walletconnect.org https://secure.walletconnect.com https://secure.walletconnect.org; child-src 'self' https://*.walletconnect.com https://*.walletconnect.org;
  X-Content-Type-Options: nosniff
