pragma solidity 0.8.20;
interface ICryptoPhunksMarket {
    function buyPhunk(uint phunkIndex) external payable;
    function phunksOfferedForSale(uint phunkIndex) external view returns (
        bool isForSale,
        uint phunkIndex_,
        address seller,
        uint minValue,
        address onlySellTo
    );
}

contract CarlStrategy is Ownable, ReentrancyGuard, IERC721Receiver {

    address public constant CRYPTO_PHUNKS_MARKET = 0xd6c037bE7FA60587e174db7A6710f7635d2971e7;
    address public constant CRYPTO_PHUNKS_V2 = 0xf07468eAd8cf26c752C676E43C814FEe9c8CF402;

    address payable public forwardAddress;
    uint256 public treasuryBps; // basis points kept in treasury (out of 10000)

    event Received(uint256 amount, uint256 keptForTreasury, uint256 forwarded);
    event V2PhunkBought(uint256 indexed tokenId, uint256 price);
    event V2PhunkWithdrawn(uint256 indexed tokenId, address to);
    event TreasurySplitUpdated(uint256 treasuryBps);
    event ForwardAddressUpdated(address newAddress);
    event ETHWithdrawn(uint256 amount, address to);

    constructor(
        address payable _forwardAddress,
        uint256 _treasuryBps
    ) Ownable(msg.sender) {
        require(_treasuryBps <= 10000, "Invalid bps");
        forwardAddress = _forwardAddress;
        treasuryBps = _treasuryBps;
    }

    /// @notice Receives ETH from Market revShare, splits between treasury and forward address
    receive() external payable {
        uint256 keepAmount = msg.value * treasuryBps / 10000;
        uint256 forwardAmount = msg.value - keepAmount;

        if (forwardAmount > 0 && forwardAddress != address(0)) {
            (bool sent, ) = forwardAddress.call{value: forwardAmount}("");
            require(sent, "Forward failed");
        }

        emit Received(msg.value, keepAmount, forwardAmount);
    }

    /// @notice Buy a V2 CryptoPhunk from the CryptoPhunksMarket
    /// @param phunkIndex The token index to buy (0-9999)
    function buyV2Phunk(uint256 phunkIndex) external onlyOwner nonReentrant {
        ICryptoPhunksMarket market = ICryptoPhunksMarket(CRYPTO_PHUNKS_MARKET);

        (bool isForSale, , , uint256 minValue, address onlySellTo) = market.phunksOfferedForSale(phunkIndex);

        require(isForSale, "Not for sale");
        require(onlySellTo == address(0) || onlySellTo == address(this), "Private sale");
        require(address(this).balance >= minValue, "Insufficient balance");

        market.buyPhunk{value: minValue}(phunkIndex);

        emit V2PhunkBought(phunkIndex, minValue);
    }

    /// @notice Withdraw a V2 Phunk NFT from the treasury
    /// @param tokenId The token ID to withdraw
    /// @param to The address to send the NFT to
    function withdrawV2Phunk(uint256 tokenId, address to) external onlyOwner {
        require(to != address(0), "Invalid address");
        IERC721(CRYPTO_PHUNKS_V2).safeTransferFrom(address(this), to, tokenId);
        emit V2PhunkWithdrawn(tokenId, to);
    }

    /// @notice Emergency withdraw ETH from the treasury
    /// @param amount Amount of ETH to withdraw in wei
    /// @param to Address to send ETH to
    function withdrawETH(uint256 amount, address payable to) external onlyOwner nonReentrant {
        require(to != address(0), "Invalid address");
        require(amount <= address(this).balance, "Insufficient balance");

        (bool sent, ) = to.call{value: amount}("");
        require(sent, "Transfer failed");

        emit ETHWithdrawn(amount, to);
    }

    /// @notice Update the percentage kept in treasury
    /// @param _bps Basis points (0-10000). 10000 = keep 100%, 5000 = keep 50%
    function setTreasuryBps(uint256 _bps) external onlyOwner {
        require(_bps <= 10000, "Invalid bps");
        treasuryBps = _bps;
        emit TreasurySplitUpdated(_bps);
    }

    /// @notice Update the forward address
    /// @param _addr New address to forward ETH to
    function setForwardAddress(address payable _addr) external onlyOwner {
        forwardAddress = _addr;
        emit ForwardAddressUpdated(_addr);
    }

    /// @notice Get the current ETH balance of the treasury
    function getBalance() external view returns (uint256) {
        return address(this).balance;
    }

    /// @notice Get how many V2 Phunks the treasury holds
    function getV2PhunkBalance() external view returns (uint256) {
        return IERC721(CRYPTO_PHUNKS_V2).balanceOf(address(this));
    }

    /// @notice ERC721 receiver callback - required to accept safeTransferFrom
    function onERC721Received(
        address,
        address,
        uint256,
        bytes calldata
    ) external pure override returns (bytes4) {
        return this.onERC721Received.selector;
    }
}
